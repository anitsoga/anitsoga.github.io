---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% comment %}
    `hide_header: true` in a page's front matter suppresses the title and
    description shown here, without removing them from the front matter —
    the navbar link and the browser tab still need page.title.
  {% endcomment %}
  {% unless page.hide_header %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% comment %}
        Skip the description entirely when there is none, rather than leaving an
        empty <p> that still contributes its bottom margin as a stray gap.
      {% endcomment %}
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>
  {% endunless %}

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
